{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TarazBan_Accounting",
  "version": "1.0.0",
  "identifier": "com.tarazban.accounting",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ترازبان — سیستم حسابداری و صرافی دوارزی",
        "width": 1360,
        "height": 850,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Curen Multi-Currency Exchange & Accounting System",
    "longDescription": "High-performance native desktop accounting software for Windows with offline hardware security.",
    "copyright": "TarazBan 2026"
  }
}
